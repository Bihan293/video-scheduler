# Public URL of the deployed app (HTTPS is required by TikTok).
BASE_URL=https://your-app.onrender.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# TikTok for Developers -> your app -> Keys
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the TikTok app.
TIKTOK_REDIRECT_URI=https://your-app.onrender.com/auth/tiktok/callback

# Scopes requested from the user.
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish

# Telegram bot from @BotFather (optional).
TELEGRAM_BOT_TOKEN=

# Shown on the website and in the policies.
CONTACT_EMAIL=

# Remove DEMO_MODE (or set 0) once real TikTok keys are configured.
DEMO_MODE=1

# Max upload size for the website, MB.
MAX_UPLOAD_MB=500
